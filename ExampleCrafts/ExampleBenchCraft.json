{
  "Name": "Example Bench Craft",
  "Description": "Spams Orb of Alteration when no prefix is open, then crafts Mana when no crafted mod exists",
  "ItemSelection": "Rarity == ItemRarity.Magic",
  "Conditions": [
    {
      "Type": "Craft (25-34) to maximum Mana",
      "Query": "!ModsInfo.ExplicitMods.Any(DisplayName == \"Upgraded\") && ModsInfo.OpenPrefixCount >= 1",
      "UseShift": false
    },
    {
      "Type": "Orb of Alteration",
      "Query": "ModsInfo.OpenPrefixCount < 1",
      "UseShift": true
    }
  ]
}
