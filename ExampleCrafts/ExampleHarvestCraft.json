{
  "Name": "Example Harvest Craft",
  "Description": "Uses chaos orb when no life modifier, otherwise uses reforge cold harvest craft",
  "ItemSelection": "Rarity == ItemRarity.Rare",
  "Conditions": [
    {
      "Type": "Reforge Cold",
      "Query": "new[] {ModsInfo.ExplicitMods.Any(Name == \"IncreasedLife\")}.Count(x => x) >= 1",
      "UseShift": false
    },
    {
      "Type": "Chaos Orb",
      "Query": "new[] {ModsInfo.ExplicitMods.Any(Name == \"IncreasedLife\")}.Count(x => x) < 1",
      "UseShift": true
    }
  ]
}
