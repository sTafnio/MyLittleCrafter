// This is an example file for a harvest craft using currency and the harvest bench.
// All rules from ExampleCurrencyCraft.craft apply.
// Only Reforge is support, e.g. "Reforge Cold" or "Reforge Lightning".
// Reforge harvest crafts are indicated by the "Reforge" prefix in the header.
// Do not manually select or de-select any harvest crafts. If something fails, just open the bench again.
// The item in the bench when crafting starts is considered a potential crafting base.
// The example below uses a chaos orb when no life modifier is on the item, otherwise it uses reforge cold harvest craft.


#Global
Rarity == ItemRarity.Rare

#Reforge Cold
new[] {
        ModsInfo.ExplicitMods.Any(Name == "IncreasedLife")
    }.Count(x => x) >= 1

#$Chaos Orb
new[] {
        ModsInfo.ExplicitMods.Any(Name == "IncreasedLife")
    }.Count(x => x) < 1
