{
  "Name": "Example Currency Craft",
  "Description": "Regular craft using currency for rustic sash or chain belt",
  "ItemSelection": "ContainsString(BaseName, new[] { \"Rustic Sash\", \"Chain Belt\" }) && Rarity != ItemRarity.Unique",
  "Conditions": [
    {
      "Type": "Orb of Transmutation",
      "Query": "Rarity == ItemRarity.Normal",
      "UseShift": false
    },
    {
      "Type": "Orb of Scouring",
      "Query": "Rarity == ItemRarity.Rare",
      "UseShift": false
    },
    {
      "Type": "Orb of Augmentation",
      "Query": {
        "Or": [
          "new[] {ModsInfo.ExplicitMods.Any(Name == \"IncreasedLife\")}.Count(x => x) == 1 && ModsInfo.OpenSuffixCount >= 1",
          "new[] {ModsInfo.ExplicitMods.Any(Name == \"FireResist\"), ModsInfo.ExplicitMods.Any(Name == \"ColdResist\"), ModsInfo.ExplicitMods.Any(Name == \"LightningResist\")}.Count(x => x) == 1 && ModsInfo.OpenPrefixCount >= 1"
        ]
      },
      "UseShift": false
    },
    {
      "Type": "Orb of Alteration",
      "Query": "new[] {ModsInfo.ExplicitMods.Any(Name == \"FireResist\"), ModsInfo.ExplicitMods.Any(Name == \"ColdResist\"), ModsInfo.ExplicitMods.Any(Name == \"LightningResist\"), ModsInfo.ExplicitMods.Any(Name == \"IncreasedLife\")}.Count(x => x) < 2",
      "UseShift": true
    }
  ]
}
